{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\" \".github/workflows/*.yml\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium --pass-with-no-tests",
    "test:e2e:public": "playwright test --project=chromium --pass-with-no-tests tests/e2e/public-smoke.spec.ts",
    "task:contract": "python scripts/audit_tasks.py",
    "screen:contract": "python scripts/check_screen_contract.py",
    "wave:contract": "python scripts/check_waves.py",
    "validate": "python scripts/validate_inputs.py && npm run task:contract && npm run wave:contract && npm run screen:contract && python scripts/validate_harness.py",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run task:contract && npm run screen:contract -- --mode ci && npm run build",
    "release:check": "npm run ci && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
